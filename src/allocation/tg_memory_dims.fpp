            allocate (tg_array%array(${dimensions_array_size(RANK)}$))

            memory_total = memory_total + total_array_size
            memory_max = max(memory_total, memory_max)

            tg_array%used_dims = dims
            tg_array%dims = dims
            tg_array%allocated = .true.
            tg_array%name = name

